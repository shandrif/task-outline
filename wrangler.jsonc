{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hm-staff-evaluation",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hm-staff-evaluation-eu",
      // Replaced automatically by `npm run setup:cloud` (or paste the id from `wrangler d1 create`)
      "database_id": "7da39df4-a4ee-435a-be06-0653f8a1873a",
      "migrations_dir": "migrations"
    }
  ],
  // Runs the Worker next to the database, so the several queries per request are not made across the world
  "placement": { "mode": "smart" },
  "vars": { "ADMIN_USERNAME": "admin" }
}
