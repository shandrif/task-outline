{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hm-staff-evaluation",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hm-staff-evaluation",
      // Replaced automatically by `npm run setup:cloud` (or paste the id from `wrangler d1 create`)
      "database_id": "ea27baac-dc0f-4446-811a-409a8df4978b",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "ADMIN_USERNAME": "admin" }
}
